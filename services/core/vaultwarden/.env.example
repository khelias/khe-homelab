VAULTWARDEN_DOMAIN=https://vault.khe.ee
SIGNUPS_ALLOWED=false
# An argon2 PHC hash, never the plain token: docker exec -it vaultwarden
# /vaultwarden hash prints the line. Single quotes keep Compose off the $ signs.
ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$<salt>$<hash>'
DATA_PATH=/srv/data/vaultwarden
