# Copy to .env on VM and fill in real values. Never commit .env.
#
# At least one provider key must be set. The models and DEFAULT_PROVIDER
# are set in docker-compose.yml, not here.

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Shared by adventure-web, which hands it to the page, and the proxy, which
# checks each request's HMAC signature with it. Left empty, the proxy accepts
# unsigned requests. Generate with: openssl rand -hex 32
API_SECRET=
