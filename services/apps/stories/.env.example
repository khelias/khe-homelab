# Copy to .env on the VM and fill in real values by the read -rs pattern of
# docs/runbook.md. Never commit .env. What each value is: khe-stories
# server/.env.example. The family's names and phrase live only here.

# The children's names, comma-separated (the authors the stories repo accepts).
CHILDREN=
# The phrase is four random words (diceware), not a sentence: pairing allows
# twenty tries an hour in all, and a LAN client can dodge the per-address limit.
# read -rs P && printf '%s' "$P" | docker compose run --rm -T stories-api node notify.ts --hash-phrase
FAMILY_PHRASE_HASH=
# Fine-grained PAT on khelias/khe-bunny-tales, Actions: write only.
GITHUB_TOKEN=
# Its own Google Cloud project with a budget alert, not the adventure key.
GEMINI_API_KEY=
# docker compose run --rm -T stories-api node notify.ts --vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: address the push services may write to.
VAPID_SUBJECT=

# Optional overrides of the starting caps (defaults in khe-stories server/config.ts).
# CAP_PER_CHILD_PER_DAY=3
# CAP_PER_MONTH=25
# CAP_QUEUED=5
