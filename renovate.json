{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor"
  ],
  "labels": ["dependencies"],
  "timezone": "Europe/Tallinn",
  "schedule": ["every weekend"],
  "pinDigests": true,
  "platformAutomerge": true,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Automerge Docker patch, minor, and digest updates. Critical infrastructure opts back out in a later rule.",
      "matchManagers": ["docker-compose", "dockerfile"],
      "matchUpdateTypes": ["patch", "minor", "digest"],
      "automerge": true
    },
    {
      "description": "Major updates need manual review",
      "matchManagers": ["docker-compose", "dockerfile"],
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "breaking"]
    },
    {
      "description": "Critical infrastructure: never automerge, collect every update type into one PR. Placed after the automerge rule so it overrides it, which keeps the package list in exactly one place.",
      "matchManagers": ["docker-compose", "dockerfile"],
      "matchUpdateTypes": ["patch", "minor", "major", "digest"],
      "matchPackageNames": [
        "adguard/adguardhome",
        "cloudflare/cloudflared",
        "docker.io/valkey/valkey",
        "ghcr.io/immich-app/immich-machine-learning",
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/postgres",
        "ghcr.io/n8n-io/n8n",
        "ghcr.io/paperless-ngx/paperless-ngx",
        "jc21/nginx-proxy-manager",
        "nextcloud",
        "postgres",
        "redis",
        "tecnativa/docker-socket-proxy",
        "vaultwarden/server"
      ],
      "automerge": false,
      "groupName": "critical infrastructure",
      "groupSlug": "critical-updates"
    }
  ]
}
