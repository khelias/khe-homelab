[Unit]
Description=Claude Code Remote Control for the workspace agent

[Service]
WorkingDirectory=%h/khe
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/claude remote-control --spawn same-dir
# Server mode runs without a terminal but redraws its status screen on stdout
# every second; errors still reach the journal on stderr.
StandardOutput=null
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
